{{- /*
  vim:ft=sshconfig.gotmpl:
*/ -}}
{{- if ( and (hasKey . "work") ( eq .work true) ) -}}
Include ~/.dotfiles/work/.ssh_config
{{- end }}

Host *
    SendEnv LANG LC_*
    HashKnownHosts yes

Host *.tmate.io
    ForwardAgent no

Host yojimbo
  ForwardAgent yes
  User selu
  IdentityFile ~/.ssh/personal

Host gigalmesh
  ForwardAgent yes
  User selu
  IdentityFile ~/.ssh/personal

Host openwrt
  User root
  IdentityFile ~/.ssh/personal

Host rock-3a
  User selu
  IdentityFile ~/.ssh/personal
